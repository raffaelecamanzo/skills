% Standard Pandoc LaTeX Template — clean, professional, no branding
% Usage: pandoc --template=standard.latex --pdf-engine=xelatex input.md -o output.pdf
\documentclass[$if(fontsize)$$fontsize$$else$11pt$endif$,$if(papersize)$$papersize$$else$a4paper$endif$]{article}

% ── Geometry ──────────────────────────────────────────────────────
\usepackage[margin=2.5cm,headheight=1.2cm,headsep=0.6cm$if(landscape)$,landscape$endif$]{geometry}

% ── Fonts (XeLaTeX) ──────────────────────────────────────────────
\usepackage{fontspec}
\setmainfont{$if(mainfont)$$mainfont$$else$Helvetica Neue$endif$}
\setmonofont[Scale=0.85]{$if(monofont)$$monofont$$else$Menlo$endif$}
% Fallback for Unicode arrows/symbols missing from Helvetica Neue
\usepackage{newunicodechar}
\newfontfamily\symbolfont{Apple Symbols}
\newunicodechar{→}{{\symbolfont →}}
\newunicodechar{↔}{{\symbolfont ↔}}
\newunicodechar{←}{{\symbolfont ←}}
\newunicodechar{∈}{{\symbolfont ∈}}
\newunicodechar{▢}{{\symbolfont ▢}}
\newunicodechar{⚠}{{\symbolfont ⚠}}
% Support for markdown checkboxes (- [ ] rendered as \square by pandoc)
\usepackage{amssymb}

% ── Colors ───────────────────────────────────────────────────────
\usepackage{xcolor}
\definecolor{stdblue}{HTML}{2B579A}
\definecolor{stdsky}{HTML}{3A7CA5}
\definecolor{stddark}{HTML}{2D3436}
\definecolor{stdmuted}{HTML}{636E72}

% ── Typography ───────────────────────────────────────────────────
\usepackage{microtype}

% ── Pandoc common partial (tables, graphics, lists, highlighting) ─
$common.latex()$

% ── Header / Footer ─────────────────────────────────────────────
\usepackage{fancyhdr}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

% Header: document title left, date right
$if(title)$
\fancyhead[L]{\small\color{stdmuted}\textit{$title$}}
$endif$
$if(date)$
\fancyhead[R]{\small\color{stdmuted}$date$}
$endif$

% Footer: page number center
\fancyfoot[C]{\small\color{stdmuted}\thepage}

% Apply same style to plain pages (first page, chapter openers)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0.4pt}%
  \fancyfoot[C]{\small\color{stdmuted}\thepage}%
}

% ── Headings ─────────────────────────────────────────────────────
\usepackage{titlesec}
\titleformat{\section}
  {\Large\bfseries\color{stddark}}{\color{stdblue}\thesection}{1em}{}
\titleformat{\subsection}
  {\large\bfseries\color{stddark}}{\color{stdblue}\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalsize\bfseries\color{stddark}}{\color{stdblue}\thesubsubsection}{1em}{}

% ── Links ────────────────────────────────────────────────────────
\usepackage[unicode=true]{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=stdblue,
  citecolor=stdsky,
  urlcolor=stdblue,
  breaklinks=true
}
\urlstyle{same}

% ── Header includes (user overrides) ────────────────────────────
$for(header-includes)$
$header-includes$
$endfor$

% ── Document ─────────────────────────────────────────────────────
\begin{document}

% ── Title Block (inline, no separate page) ───────────────────────
$if(title)$
{
  \raggedright
  {\huge\bfseries\color{stddark}$title$\par}
  \vspace{0.3em}
  {\color{stdblue}\rule{\linewidth}{1pt}\par}
  \vspace{0.4em}
  $if(subtitle)${\large\color{stdmuted}$subtitle$\par}\vspace{0.3em}$endif$
  $if(author)${\normalsize\color{stdmuted}$for(author)$$author$$sep$, $endfor$\par}$endif$
  $if(date)${\normalsize\color{stdmuted}$date$\par}$endif$
  \vspace{1.5em}
}
$endif$

% ── Table of Contents ────────────────────────────────────────────
$if(toc)$
{
  \hypersetup{linkcolor=stddark}
  \setcounter{tocdepth}{$if(toc-depth)$$toc-depth$$else$3$endif$}
  \tableofcontents
  \newpage
}
$endif$

$body$

$for(include-after)$
$include-after$
$endfor$

\end{document}
